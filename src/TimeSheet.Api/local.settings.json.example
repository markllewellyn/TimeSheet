{
    "IsEncrypted": false,
    "Values": {
        "AzureWebJobsStorage": "UseDevelopmentStorage=true",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",

        "AzureAd:Instance": "https://login.microsoftonline.com/",
        "AzureAd:TenantId": "<your-entra-tenant-id>",
        "AzureAd:ClientId": "<the-app-registration-client-id>",
        "AzureAd:Audience": "api://<the-app-registration-client-id>",
        "AzureAd:ClientSecret": "<the-app-registration-client-secret>",
        "AzureAd:RedirectUri": "http://localhost:3000/api/auth/callback/microsoft-entra-id",

        "Frontend:BaseUrl": "http://localhost:3000",

        "ConnectionStrings:TimesheetDb": "Data Source=timesheet.db",

        "LocalAuth:JwtSigningKey": "<a-long-random-string-unique-to-this-environment>",

        "GraphAdmin:TenantId": "<your-entra-tenant-id>",
        "GraphAdmin:ClientId": "<the-Graph-admin-app-registration-client-id>",
        "GraphAdmin:ClientSecret": "<the-Graph-admin-app-registration-client-secret>",
        "GraphAdmin:SendMailAsUser": "noreply@svgit.co.uk",

        "Claude:ApiKey": "<your-anthropic-api-key>",

        "AttachmentsRootPath": "C:\\TimeSheetData\\Attachments"
    },
    "Host": {
        "CORS": "http://localhost:4200"
    }
}
